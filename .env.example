# Заполните локально. Этот файл не коммитится и не доступен браузеру.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
AI_EVALUATOR_MODEL=gpt-6.1-terra
AI_EVALUATOR_INPUT_USD_PER_MILLION=
AI_EVALUATOR_OUTPUT_USD_PER_MILLION=
# default = Standard; fast = 2x; ultrafast = Sol 6x, Terra/Luna Fast 2x.
# Применяется ко всем вызовам, включая поиск, проверки и оценщика.
AI_SERVICE_TIER=fast
# quality: план low, проверка сведений medium, ответ/оценщик medium, бриф MVP high.
# speed сохраняет прежний профиль none/low; без настройки используется speed.
AI_REASONING_PROFILE=quality
# Ноль отключает платные вызовы. Лимит согласуем перед живой проверкой.
AI_BUDGET_USD=0
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data
# Локальная демонстрация экрана в Zoom; origin должен совпадать с браузером
APP_ORIGIN=http://localhost:3000
# Базовые ставки Standard USD/1M; коэффициент режима применяется отдельно.
# Для неизвестной модели нужны обе ставки; ускорение — для известных моделей.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Включая reasoning/JSON: quality — ответ, черновик и MVP до128000.
# План/поиск до16384, проверка сведений до32768. Это запас, не целевой объём.
# Общий максимум128000; явный меньший лимит соблюдается.
AI_MAX_OUTPUT_TOKENS=128000
# Оценщик и исправление оценки:32768, настраивается до128000.
AI_EVALUATOR_MAX_OUTPUT_TOKENS=32768
# Один вызов и оценщик до15минут, общая задача с исследованием до60минут.
AI_TIMEOUT_MS=900000
# Dev API по умолчанию 3001. Production использует PORT.
API_PORT=
# Пустое = не доверять X-Forwarded-For. 1 только за контролируемым reverse proxy.
TRUST_PROXY_HOPS=

# Пустое = проверенный hosted web search; 0 отключает внешний поиск.
AI_WEB_SEARCH=
