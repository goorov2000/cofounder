{
  "name": "cofounder-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 3000",
    "dev:server": "tsx watch --include=./shared/**/*.ts server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "test:e2e": "playwright test",
    "evaluate:core": "tsx scripts/evaluate-bot-core.ts",
    "methods:check": "tsx scripts/import-methods.ts --check",
    "methods:import": "tsx scripts/import-methods.ts",
    "skills:check": "tsx scripts/import-topic-skills.ts --check",
    "skills:import": "tsx scripts/import-topic-skills.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "lucide-react": "1.72.0",
    "openai": "7.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
